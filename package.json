{
  "name": "selfit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:reset": "pnpm --filter @selfit/api run db:reset",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm -r --filter \"./apps/*\" --if-present run build",
    "typecheck": "pnpm -r --filter \"./apps/*\" --if-present run typecheck",
    "test": "pnpm -r --filter \"./apps/*\" --if-present run test",
    "start": "node apps/api/dist/server.mjs",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
